FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl sqlite3 && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user (matches production Dockerfile and K8s securityContext)
RUN groupadd -r genesia && useradd -r -g genesia -m -d /home/genesia -u 1000 genesia

# Copy project files (including local_prompt_enhancer.py required by pyproject.toml)
COPY --chown=genesia:genesia pyproject.toml ./
COPY --chown=genesia:genesia agents/ ./agents/
COPY --chown=genesia:genesia genesia/ ./genesia/
COPY --chown=genesia:genesia local_prompt_enhancer.py ./
COPY --chown=genesia:genesia scripts/ ./scripts/

# Install with agents + sandbox extras (provides python-dotenv, rich, pydantic, opensandbox SDK, etc.)
RUN pip install --no-cache-dir -e ".[agents,sandbox]"

# Create data directory for genesia user
RUN mkdir -p /home/genesia/.genesia && chown -R genesia:genesia /home/genesia/.genesia

# Switch to non-root user
USER genesia

# Default environment — vLLM backend (matches Paperclip stack)
ENV GENESIA_TASK_TYPE=""
ENV GENESIA_BACKEND_HOST="vllm"
ENV GENESIA_BACKEND_PORT="8000"
ENV HOME=/home/genesia

# Heartbeat mode by default (use CMD so args can be overridden)
ENTRYPOINT ["python", "-m", "agents.main"]
CMD ["--heartbeat"]
