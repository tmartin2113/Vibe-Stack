# Caddyfile — Vibe Stack 2.0
#
# Virtual hosts:
#   1. Paperclip UI  — https://<hostname>        (443)
#   2. n8n           — https://<hostname>:5678
#   3. Staging       — https://<hostname>:8100-8119 (dev-runner)
#
# Prerequisites:
#   xcaddy build --with github.com/mholt/caddy-ratelimit
#   apt install libnss3-tools  (for certutil — local CA trust)

{
    default_bind {$TAILSCALE_IP}

    log {
        output file /var/log/caddy/access.log {
            roll_size     10MiB
            roll_keep     14
            roll_keep_for 720h
        }
        format json
        level  INFO
    }
}

# ── HTTP -> HTTPS redirects ─────────────────────────────────────
http://{$TAILSCALE_HOSTNAME} {
    redir https://{$TAILSCALE_HOSTNAME}{uri} permanent
}

# ── Shared TLS macro ───────────────────────────────────────────
(tailscale_tls) {
    tls internal
}

# ── Shared security headers macro ─────────────────────────────
(security_headers) {
    header {
        X-Content-Type-Options        "nosniff"
        X-Frame-Options               "SAMEORIGIN"
        X-XSS-Protection              "1; mode=block"
        Strict-Transport-Security     "max-age=31536000; includeSubDomains"
        Referrer-Policy               "no-referrer-when-downgrade"
        Permissions-Policy            "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

# ── CSP for staging apps — browser-enforced exfil prevention ─────
(staging_csp) {
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src 'none'; object-src 'none'"
    }
}

# ── WebSocket proxy macro ──────────────────────────────────────
(websocket_proxy) {
    @websocket {
        header Connection *Upgrade*
        header Upgrade    websocket
    }
    handle @websocket {
        reverse_proxy {args[0]} {
            transport http {
                dial_timeout 10s
            }
        }
    }
}

# ── Paperclip UI (replaces Open WebUI) ───────────────────────────
https://{$TAILSCALE_HOSTNAME} {
    import tailscale_tls
    import security_headers

    rate_limit {
        zone paperclip {
            key    {remote_host}
            events 500
            window 1m
        }
    }

    import websocket_proxy 127.0.0.1:3100

    reverse_proxy 127.0.0.1:3100 {
        health_uri      /api/health
        health_interval 30s
        health_timeout  10s

        header_up X-Real-IP {remote_host}

        transport http {
            dial_timeout            10s
            response_header_timeout 300s
            read_timeout            300s
            write_timeout           300s
        }
    }
}

# ── n8n ────────────────────────────────────────────────────────
https://{$TAILSCALE_HOSTNAME}:5678 {
    import tailscale_tls
    import security_headers

    rate_limit {
        zone n8n {
            key    {remote_host}
            events 300
            window 1m
        }
    }

    import websocket_proxy 127.0.0.1:5678

    reverse_proxy 127.0.0.1:5678 {
        health_uri      /healthz
        health_interval 30s
        health_timeout  10s

        header_up X-Real-IP {remote_host}

        transport http {
            dial_timeout            10s
            response_header_timeout 120s
            read_timeout            120s
            write_timeout           120s
        }
    }
}

# ── Dev-runner staging apps (ports 8100-8119) ──────────────────
# Generated by setup.sh — do not edit manually
# STAGING_PORTS_START
# STAGING_PORTS_END
