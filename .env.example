# Vibe Stack — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Quick start:
#   cp .env.example .env
#   ./setup.sh              # auto-detects GPU, generates secrets, fills blanks
#
# Or manually fill in values below. Lines starting with # are optional.

# ── Compose Configuration ─────────────────────────────────────────────────────
# Set by setup.sh based on detected hardware. Controls which services start.
# Manually override to change your stack profile.
#
# Full stack (GPU):   docker-compose.yml:docker-compose.infra.yml:docker-compose.gpu.yml
# Cloud only:         docker-compose.yml:docker-compose.infra.yml
# Minimal:            docker-compose.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.infra.yml

# ── Image Versions ────────────────────────────────────────────
# Production: pin to a semver tag (e.g. v1.0.0) for stability.
# Development: use 'latest' for bleeding edge.
# Available tags: semver (v1.0.0), SHA (sha-abc123f), latest
PAPERCLIP_VERSION=latest

# ── Local Development (optional) ──────────────────────────────
# Set PAPERCLIP_SOURCE_DIR to build server/deerflow from local source
# instead of pulling GHCR images. Use with docker-compose.override.yml.
# PAPERCLIP_SOURCE_DIR=/path/to/paperclip

# ── Host & Network (setup.sh auto-detects these) ────────────
GIT_USER=your-github-username
GHCR_ORG=your-github-username
# TAILSCALE_HOSTNAME=                  # Auto-detected by setup.sh
# TAILSCALE_IP=                        # Auto-detected by setup.sh
# WORKSPACE_PATH=/srv/sftp/workspace/files

# ── Project Files (mounted into agent containers) ───────────
# Host directory containing your code. Bind-mounted read-only into the
# paperclip server, deerflow-langgraph, and deerflow-gateway containers at
# two paths:
#   /workspace          — canonical path agents should use in prompts
#   ${HOME}/Projects    — host-HOME path so absolute paths from issue
#                         descriptions (e.g. /home/alice/Projects/foo/...)
#                         resolve inside the container
# Default: ${HOME}/Projects
# PAPERCLIP_PROJECTS_DIR=${HOME}/Projects

# ── Model & Backend ──────────────────────────────────────────
# Override default model (default: Qwen/Qwen3.5-9B for vLLM)
# MODEL_NAME=Qwen/Qwen3.5-9B

# Development mode — enables debug logging, disables Mattermost posting
# DEV_MODE=false

# ── LLM Backend ──────────────────────────────────────────────
# Ollama runs natively on the host and provides an OpenAI-compatible API.
# The vibe agent connects to it via host.docker.internal.
# VIBE_BACKEND_HOST=host.docker.internal
# VIBE_BACKEND_PORT=11434

# ── Ollama (local inference, runs on host) ───────────────────
# Model served by Ollama. Set by setup.sh based on available memory.
# Tier table (matches setup.sh logic):
#
#   >= 40 GB                    -> qwen3.5:27b     (full 27B model)
#   >= 20 GB (3090, M2 32GB)   -> qwen3.5:9b      (sweet spot)
#   12-19 GB                   -> qwen3.5:9b      (reduced context)
#    8-11 GB                   -> qwen3.5:4b      (minimum viable)
#   <  8 GB                    -> disabled, use cloud API
OLLAMA_MODEL=

# ── Legacy vLLM (no longer default -- use Ollama instead) ────
# These variables are only needed if you manually run a vLLM server.
# setup.sh no longer configures vLLM. Set VIBE_BACKEND_PORT=8000
# and configure these if you want to use vLLM instead of Ollama.
# VLLM_MODEL=
# VLLM_API_URL=http://host.docker.internal:8000/v1
# VLLM_TOOL_CALL_PARSER=qwen3_xml
# VLLM_QUANTIZATION=awq
# VLLM_MAX_MODEL_LEN=65536
# VLLM_MAX_NUM_SEQS=4
# VLLM_GPU_MEM_UTIL=0.92

# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=WARNING                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT=json                      # structured JSON logging (recommended for production)

# ── Paperclip Integration (required for heartbeat mode) ──────
# In Docker Compose, use service name: http://server:3100
# For standalone: http://localhost:3100
PAPERCLIP_API_URL=http://server:3100
PAPERCLIP_AGENT_ID=                     # Agent UUID — auto-populated by bootstrap-org.cjs
# PAPERCLIP_API_KEY=                    # Bearer token from Paperclip dashboard
# PAPERCLIP_COMPANY_ID=                 # Company UUID in Paperclip
PAPERCLIP_ADMIN_EMAIL=                  # Admin email for API sign-in
PAPERCLIP_ADMIN_PASSWORD=               # Admin password for bootstrap — pick a strong one
BETTER_AUTH_SECRET=                      # Required — run: openssl rand -hex 32
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3100  # Comma-separated origins for browser auth

# ── Self-Upgrade (agent self-modification) ─────────────────────
# VIBE_SELF_UPGRADE_ENABLED=true         # Enabled by default; set to false to disable
# VIBE_SELF_UPGRADE_MIN_SCORE=90         # Minimum critic score to accept a change
# VIBE_SELF_UPGRADE_MAX_DIFF_LINES=500   # Maximum diff size (lines) per proposal
# Self-upgrade Tier 3 reports and Tier 1b/2 companion issues are assigned to
# this Paperclip user (not an agent) so they land in the human Improvements
# tab and don't get auto-claimed by the agent heartbeat. Set to the Paperclip
# user_id of whoever owns self-upgrade triage.
VIBE_HUMAN_TRIAGE_USER_ID=

# ── Sandbox (code execution isolation) ───────────────────────
# VIBE_SANDBOX_BACKEND=opensandbox     # opensandbox | subprocess (fallback)
# VIBE_SANDBOX_URL=http://localhost:8080

# ── Mattermost Integration ──────────────────────────────────
# MATTERMOST_URL=http://localhost:8065
# MATTERMOST_BOT_TOKEN=
# MATTERMOST_WEBHOOK_URL=
# MATTERMOST_USERNAME=

# ── Slack Integration ────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_USER_ID=U...

# ── Slack Two-Way Bridge (adapter-level, for Paperclip heartbeat mode) ──
# VIBE_SLACK_BOT_TOKEN=xoxb-...       # Bot token for sending DMs + reading replies
# VIBE_SLACK_NOTIFY_USER_ID=U...      # Default human to DM for clarification
# VIBE_SLACK_BOT_USER_ID=U...         # Bot's own user ID (filters out bot messages)

# ── Daemon Mode ──────────────────────────────────────────────
# VIBE_DAEMON_POLL_INTERVAL=5         # seconds between polls
# VIBE_DAEMON_QUEUE_SIZE=100          # max pending requests in queue
# VIBE_DAEMON_DEDUP_TTL=3600          # seconds before dedup cache entries expire

# ── Skill Sources ────────────────────────────────────────────
# VIBE_OPENCLAW_PATH=/path/to/openclaw-skills   # 5000+ community skills, searched on-demand
# VIBE_SKILL_REPOS=                             # Colon-separated skill repo paths (setup.sh auto-populates)

# ── Skill Registry Tuning ────────────────────────────────────────────
# VIBE_SKILL_MIN_USAGE_FOR_PROMOTION=3     # Min uses before temp→local promotion
# VIBE_SKILL_MIN_AVG_SCORE_FOR_PROMOTION=85 # Min avg score for promotion
# VIBE_SKILL_TEMP_TTL_DAYS=7               # Days before unused temp skills evicted
# VIBE_SKILL_OFFICIAL_TTL_DAYS=30          # Days before unused cached skills evicted
# VIBE_SKILL_OFFICIAL_CONFIDENCE=0.4       # Min match score to load an official-tier skill
# VIBE_SKILL_LOCAL_CONFIDENCE=0.35         # Min match score to load a local-tier skill
# VIBE_SKILL_TEMP_CONFIDENCE=0.35          # Min match score to load a temp-tier skill

# ── Sandbox Resource Limits ──────────────────────────────────────────────
# VIBE_EXEC_CPU_LIMIT_SECONDS=30           # Max CPU time for code execution
# VIBE_EXEC_MEMORY_LIMIT_MB=256            # Max memory (MB) for code execution
# VIBE_EXEC_FSIZE_LIMIT_MB=10              # Max file creation size (MB)
# VIBE_EXEC_NPROC_LIMIT=32                 # Max child processes

# ── Health / Metrics / Observability ───────────────────────────
# VIBE_HEALTH_PORT=8080               # port for /healthz, /readyz, /metrics
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...  # Incoming webhook for agent health alerts

# ── Grafana (available at http://localhost:3333) ──────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=vibe

# ── LangSmith Tracing (optional — DeerFlow agent decisions) ──
# Sign up at https://smith.langchain.com, create an API key.
# Set LANGSMITH_TRACING=true to enable; leave false to disable.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=vibe-stack

# ── API Key Prompting (daemon) ───────────────────────────────
# VIBE_PROMPT_TIMEOUT=5               # seconds to wait for key input
# VIBE_POLL_INTERVAL=2                # seconds between poll attempts

# ── Docker Resource Limits ─────────────────────────────────────────────────
# Set these based on your hardware. Defaults are for a 24GB GPU system.
# VIBE_VLLM_MEMORY_LIMIT=24G         # vLLM container memory cap
# VIBE_SANDBOX_MEMORY_LIMIT=4G       # OpenSandbox container memory cap
# VIBE_AGENT_MEMORY_LIMIT=2G         # Agent container memory cap

# ── Docker Compose (multi-agent production stack) ────────────
# VIBE_IMAGE_TAG=latest                  # Agent container image tag
# VLLM_TP_SIZE=2                         # Tensor parallelism (GPU count)
# ── Agent IDs (auto-populated by bootstrap-org.js) ────────────────
# PAPERCLIP_AGENT_ID_CTO=
# PAPERCLIP_AGENT_ID_CTO_ASSISTANT=
# PAPERCLIP_AGENT_ID_BACKEND=
# PAPERCLIP_AGENT_ID_BACKEND_ASSISTANT=
# PAPERCLIP_AGENT_ID_FRONTEND=
# PAPERCLIP_AGENT_ID_FRONTEND_ASSISTANT=
# PAPERCLIP_AGENT_ID_QA=
# PAPERCLIP_AGENT_ID_QA_ASSISTANT=
# PAPERCLIP_AGENT_ID_DEVOPS=
# PAPERCLIP_AGENT_ID_DEVOPS_ASSISTANT=

# ── Tailscale (remote access from phone/laptop) ─────────────
# TS_AUTHKEY=tskey-auth-...           # From https://login.tailscale.com/admin/settings/keys
                                       # Leave blank for interactive auth (prints URL in logs)
# TS_HOSTNAME=vibe                     # Node name on your tailnet (default: vibe)
# TS_USERSPACE=true                    # Run in userspace mode (default: true)

# ── Infrastructure Service URLs (enables agent tools) ────────
# Docker DNS names — these let the vibe agent discover infrastructure tools.
# setup.sh sets these automatically. Only change if you rename services.
SEARXNG_URL=http://searxng:8080
PLAYWRIGHT_WS_URL=ws://playwright:3003
PENPOT_API_URL=http://penpot-backend:3000
GITEA_URL=http://gitea:3000
# GITEA_TOKEN=                         # Personal access token for Gitea API (generated by setup.sh)
# COMFYUI_URL=http://host.docker.internal:8188  # ComfyUI image generation service
MINIO_URL=http://minio:9000
MIROFISH_URL=http://mirofish:5001
PADDLEOCR_URL=http://paddleocr:8868

# ── Infrastructure Secrets ───────────────────────────────────
# setup.sh generates these automatically. For manual setup, run the commands shown.
SEARXNG_SECRET=                        # Run: openssl rand -hex 32
PENPOT_SECRET_KEY=                     # Run: openssl rand -hex 32
MINIO_ROOT_USER=vibe
MINIO_ROOT_PASSWORD=                   # Run: openssl rand -hex 16
GITEA_ADMIN_USER=vibe
GITEA_ADMIN_PASSWORD=                  # Run: openssl rand -hex 16
# COMFYUI_ENABLED=false               # Set true to enable GPU image generation

# ── GitHub (agent git push access) ─────────────────────────
# GH_TOKEN=                            # Run: gh auth token — lets agents push to GitHub
#                                       # Also requires ~/.gitconfig mount in docker-compose.override.yml

# ── Cloud API Keys (optional, for cloud LLM backends) ───────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# HUGGINGFACE_API_KEY=hf_...
# GOOGLE_API_KEY=

# ── MiroFish Simulation ───────────────────────────────────────
# MIROFISH_COMPLEXITY_AGENT_THRESHOLD=40   # Agent count trigger for cloud LLM
# MIROFISH_COMPLEXITY_ITER_THRESHOLD=20    # Iteration count trigger for cloud LLM
# MIROFISH_LLM_API_URL=http://host.docker.internal:11434/v1  # Local Ollama (default)
# MIROFISH_LLM_MODEL=                                      # Local model (defaults to VLLM_MODEL)
# MIROFISH_LLM_CLOUD_API_URL=             # Cloud API for complex sims
# MIROFISH_LLM_API_KEY=                   # API key for local LLM (if auth required)
# MIROFISH_LLM_CLOUD_API_KEY=             # Cloud API key
# MIROFISH_LLM_CLOUD_MODEL=              # Cloud model name

# ── Zep (self-hosted agent memory for MiroFish) ──────────────
# ZEP_API_KEY=                             # Zep API key (if auth enabled)
# ZEP_URL=http://zep:8000                 # Zep service URL
# ZEP_NEO4J_PASSWORD=                     # Neo4j password for Graphiti (generated by setup.sh)

# ── PaddleOCR (text extraction from images and PDFs) ──────────
# PADDLEOCR_TIMEOUT=30                   # Request timeout in seconds
# PADDLEOCR_MAX_PDF_PAGES=5              # Default max pages for PDFs without page_range

# ── Orchestrator (resource-aware scheduler) ────────────────────
# These control the --orchestrator mode that manages agent subprocesses.
# All are optional — auto-detection works out of the box.
# VIBE_MAX_CONCURRENT_AGENTS=            # 0 or empty = auto-detect from hardware
# VIBE_SCHEDULER_INTERVAL=30             # Poll interval in seconds
# VIBE_AGENT_TIMEOUT=600                 # Per-heartbeat timeout in seconds
# VIBE_DISABLED_AGENTS=                  # Comma-separated roles to skip
# VIBE_MEMORY_PRESSURE_THRESHOLD=90      # Pause spawning above this % memory usage
# VIBE_INFRA_RESERVE_GB=10               # RAM (GB) reserved for non-agent containers
# VIBE_ORCHESTRATOR_CPUS=4.0             # CPU limit for orchestrator container
# VIBE_ORCHESTRATOR_MEMORY_LIMIT=4G      # Memory limit for orchestrator container
