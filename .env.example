# ══════════════════════════════════════════════════════════════
# Vibe Stack 2.0 — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy to .env and customize before running setup.sh

# ── Tailscale (auto-detected by setup.sh if not set) ─────────
# Your machine's Tailscale FQDN, e.g. vibe.tailnet-name.ts.net
TAILSCALE_HOSTNAME=
# Tailscale IPv4 address (auto-detected if blank)
TAILSCALE_IP=

# ── GitHub (REQUIRED) ───────────────────────────────────────
# Your GitHub username — used by workspace-watchdog for push
GIT_USER=your-github-username
# GitHub org/user that hosts the GHCR container images (REQUIRED)
# Set to your GitHub username or org that publishes the Docker images
GHCR_ORG=your-github-username

# ── vLLM (GPU inference on host) ─────────────────────────────
# URL for the vLLM OpenAI-compatible API running on the host
VLLM_API_URL=http://host.docker.internal:8000/v1

# ── Workspace ────────────────────────────────────────────────
# Directory where agents write project files (SFTP-accessible)
WORKSPACE_PATH=/srv/sftp/workspace/files

# ── Paperclip admin credentials (for helper scripts) ─────────
# Password you set when creating your admin account in the UI
# PAPERCLIP_ADMIN_PASSWORD=

# ── Agent IDs (populated after bootstrap) ────────────────────
# PAPERCLIP_COMPANY_ID=
# PAPERCLIP_CEO_ID=

# ── Projects directory (for agent working directories) ───────
# PROJECTS_DIR=/srv/sftp/workspace/files

# ── Developer only (uncomment for local builds) ─────────────
# Path to your local paperclip source checkout
# PAPERCLIP_SOURCE_DIR=/path/to/paperclip
