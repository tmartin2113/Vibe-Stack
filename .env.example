# Genesia Environment Configuration
# Copy to .env and fill in values: cp .env.example .env

# ── Model & Backend ──────────────────────────────────────────
# Override default model (default: Qwen/Qwen3.5-9B for vLLM)
# MODEL_NAME=Qwen/Qwen3.5-9B

# Development mode — enables debug logging, disables Mattermost posting
# DEV_MODE=false

# ── LLM Backend (genesia library layer) ─────────────────────
# GENESIA_BACKEND_HOST=localhost
# GENESIA_BACKEND_PORT=11434           # ollama=11434, vllm=8000, llamacpp=8080

# ── vLLM (GPU inference on host) ─────────────────────────────
# URL for the vLLM OpenAI-compatible API running on the host
VLLM_API_URL=http://host.docker.internal:8000/v1
# Model served by vLLM — auto-detected by setup.sh based on GPU VRAM.
# Tiers: >=48GB → 27B, >=24GB → 27B-GPTQ-Int4, >=12GB → 9B, >=8GB → 4B
VLLM_MODEL=

# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=WARNING                    # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Mattermost Integration ──────────────────────────────────
# MATTERMOST_URL=http://localhost:8065
# MATTERMOST_BOT_TOKEN=
# MATTERMOST_WEBHOOK_URL=
# MATTERMOST_USERNAME=

# ── Slack Integration ────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_USER_ID=U...

# ── Slack Two-Way Bridge (adapter-level, for Paperclip heartbeat mode) ──
# GENESIA_SLACK_BOT_TOKEN=xoxb-...       # Bot token for sending DMs + reading replies
# GENESIA_SLACK_NOTIFY_USER_ID=U...      # Default human to DM for clarification
# GENESIA_SLACK_BOT_USER_ID=U...         # Bot's own user ID (filters out bot messages)

# ── Daemon Mode ──────────────────────────────────────────────
# GENESIA_DAEMON_POLL_INTERVAL=5       # seconds between polls
# GENESIA_DAEMON_QUEUE_SIZE=100        # max pending requests in queue
# GENESIA_DAEMON_DEDUP_TTL=3600        # seconds before dedup cache entries expire

# ── Health / Metrics ───────────────────────────────────────────
# GENESIA_HEALTH_PORT=8080             # port for /healthz, /readyz, /metrics
# LOG_FORMAT=json                      # structured JSON logging (recommended for production)

# ── API Key Prompting (daemon) ───────────────────────────────
# GENESIA_PROMPT_TIMEOUT=5             # seconds to wait for key input
# GENESIA_POLL_INTERVAL=2              # seconds between poll attempts

# ── Paperclip Integration (required for heartbeat mode) ────
# PAPERCLIP_API_URL=http://localhost:3100
# PAPERCLIP_API_KEY=                      # Bearer token from Paperclip dashboard
# PAPERCLIP_AGENT_ID=                     # Agent UUID assigned in Paperclip's agent registry
# PAPERCLIP_COMPANY_ID=                   # Company UUID in Paperclip

# ── Sandbox (code execution isolation) ─────────────────────
# GENESIA_SANDBOX_BACKEND=subprocess      # opensandbox | subprocess (fallback)
# GENESIA_SANDBOX_URL=http://localhost:8080

# ── Docker Compose (production stack) ─────────────────────
# GENESIA_IMAGE_TAG=latest                  # Agent container image tag
# VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct  # vLLM model to load
# VLLM_TP_SIZE=2                            # Tensor parallelism (GPU count)
# PAPERCLIP_AGENT_ID_CODE=                  # Agent UUID for code specialist
# PAPERCLIP_AGENT_ID_TEST=                  # Agent UUID for test specialist
# PAPERCLIP_AGENT_ID_SECURITY=              # Agent UUID for security specialist
# PAPERCLIP_AGENT_ID_RESEARCH=              # Agent UUID for research specialist
# PAPERCLIP_AGENT_ID_ORCHESTRATOR=          # Agent UUID for orchestrator

# ── Cloud API Keys (optional, for cloud LLM backends) ───────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# HUGGINGFACE_API_KEY=hf_...
# GOOGLE_API_KEY=
