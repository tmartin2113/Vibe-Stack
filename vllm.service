# vLLM systemd service template
# Placeholders are filled by setup.sh based on GPU VRAM detection:
#   __VLLM_MODEL__       — full HuggingFace model ID
#   __VLLM_MODEL_SHORT__ — short name for Description line
#   __MAX_MODEL_LEN__    — context window length
#   __GPU_MEM_UTIL__     — memory utilization fraction (0.0-1.0)
#   __MAX_NUM_SEQS__     — max concurrent sequences
#   __EXTRA_ARGS__       — tier-specific flags (e.g. --enforce-eager)
#   __HF_CACHE__         — HuggingFace cache directory

[Unit]
Description=vLLM OpenAI-Compatible Server (__VLLM_MODEL_SHORT__)
After=docker.service
Requires=docker.service

[Service]
Type=simple
Restart=unless-stopped
RestartSec=10

ExecStartPre=-/usr/bin/docker rm -f vibe-vllm
ExecStart=/usr/bin/docker run \
  --name vibe-vllm \
  --gpus all \
  --ipc=host \
  -p 8000:8000 \
  -v __HF_CACHE__:/root/.cache/huggingface \
  vllm/vllm-openai:latest \
    __VLLM_MODEL__ \
    --host 0.0.0.0 \
    --port 8000 \
    --max-model-len __MAX_MODEL_LEN__ \
    --gpu-memory-utilization __GPU_MEM_UTIL__ \
    --enable-prefix-caching \
    --enable-chunked-prefill \
    --max-num-seqs __MAX_NUM_SEQS__ \
    --trust-remote-code \
    --enable-auto-tool-choice \
    --tool-call-parser hermes \
    --reasoning-parser qwen3 \
    __EXTRA_ARGS__

ExecStop=/usr/bin/docker stop vibe-vllm

[Install]
WantedBy=multi-user.target
